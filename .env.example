# AI Model Analysis Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - API Keys for core functionality
# =============================================================================

# Clerk auth (dashboard.clerk.com → API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Flask/session secret key (defined in Security section below)

# OpenRouter API key for AI model access (get one at https://openrouter.ai)
OPENROUTER_API_KEY=

# =============================================================================
# OPTIONAL - Additional data sources
# =============================================================================

# Artificial Analysis API key (for benchmark data)
ARTIFICIAL_ANALYSIS_API_KEY=

# Replicate API key (for open-source model data)
REPLICATE_API_KEY=

# Google Sheets Auth URL (for persistent user data across deploys)
# Deploy the Apps Script from docs/google_sheets_setup.md
GOOGLE_SHEETS_AUTH_URL=

# =============================================================================
# OPTIONAL - Hype feed configuration
# =============================================================================

# Supabase connection for Hype feed
HYPE_SUPABASE_URL=
HYPE_SUPABASE_API_KEY=
HYPE_SUPABASE_SOURCES=github,huggingface,reddit,replicate

# =============================================================================
# OPTIONAL - Blog feed
# =============================================================================

# WordPress REST API URL for blog posts
BLOG_POSTS_API_URL=

# =============================================================================
# OPTIONAL - Tuning parameters
# =============================================================================

# Max Replicate models to fetch
MAX_REPLICATE_MODELS=60
MAX_REPLICATE_TOTAL=250
MAX_REPLICATE_PAGES=5

# Hype feed settings
HYPE_LOOKBACK_DAYS=14
HYPE_MAX_LIMIT=120

# Server port
PORT=8765

# =============================================================================
# DATABASE - Turso (libSQL)
# =============================================================================
# Create a database: turso db create <name>
# Get URL:          turso db show <name> --url
# Get token:        turso db tokens create <name>
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Security
APP_SECRET_KEY=                      # Random secret for HMAC promo codes + sessions (generate: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SECRET=                        # Secret header value for /admin/* routes
APP_BASE_URL=https://your-app.example.com  # Canonical HTTPS app URL for Stripe redirect URLs

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...   # Stripe publishable key (safe to expose to frontend)
STRIPE_SECRET_KEY=sk_test_...        # Stripe secret key — never expose
STRIPE_WEBHOOK_SECRET=whsec_...      # From Stripe Dashboard > Webhooks
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_MAX_ANNUAL=price_...
SERVER_OPENROUTER_KEY=sk-or-...      # Separate OR key used for paid users without their own key
